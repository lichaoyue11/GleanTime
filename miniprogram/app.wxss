/* ============ 全局设计令牌（移植自原型 :root，px 不变） ============ */
page {
  --primary: #4c8bf5;
  --primary-strong: #3a73e0;
  --primary-deep: #2f63cf;
  --primary-soft: #eaf1ff;
  --primary-sel: #e3edff;
  --green: #27bd86;
  --green-soft: #eafaf3;
  --red: #fb5d5d;
  --red-soft: #fff1f1;
  --amber: #f5a623;
  --amber-soft: #fef3df;
  --text: #1e2430;
  --text-2: #8a909c;
  --text-3: #b6bcc6;
  --bg: #eef1f6;
  --card: #ffffff;
  --divider: #eef1f5;
  --shadow: 0 10px 28px rgba(24, 39, 75, .08);
  --shadow-sm: 0 2px 10px rgba(24, 39, 75, .05);
  --sh-lg: 0 24px 60px rgba(24, 39, 75, .18);

  /* 关键：page 必须有确定高度，否则子级 height:100% 会退化为内容高度，
     导致整页在文档级滚动，底部导航 / FAB 被推到折线以下（需滑到底才可见）。 */
  height: 100%;
  overflow: hidden;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}
view, text, scroll-view, input, textarea, button, navigator { box-sizing: border-box; }
