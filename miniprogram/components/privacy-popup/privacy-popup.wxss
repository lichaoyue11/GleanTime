/* 说明：自定义组件默认样式隔离，app.wxss 中的类选择器不会作用于组件内部，
   因此按钮等样式必须在组件自带 wxss 中定义（颜色仍引用全局 CSS 变量，并带字面量兜底）。 */
.pp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.pp-panel {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.pp-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text, #1e2430);
  text-align: center;
  margin-bottom: 24rpx;
}
.pp-body {
  font-size: 26rpx;
  color: var(--text-2, #8a909c);
  line-height: 1.7;
}
.pp-p {
  display: block;
}
.pp-contract {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--primary, #4c8bf5);
  text-align: center;
}
.pp-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.pp-btn {
  flex: 1;
  padding: 22rpx 0;
  font-size: 30rpx;
  line-height: 1.2;
  border-radius: 14rpx;
  text-align: center;
  overflow: hidden;
}
/* 次要按钮 */
.pp-btn-ghost {
  background: var(--primary-soft, #eaf1ff);
  color: var(--primary-deep, #2f63cf);
}
/* 主要按钮 */
.pp-btn-main {
  background: var(--primary, #4c8bf5);
  color: #ffffff;
  font-weight: 500;
}
